  }

  market_view: {
    label: "market read view"
    class: view
  }

  info_view: {
    label: "info read view"
    class: view
  }

  serenity_view: {
    label: "serenity read view"
    class: view
  }

  opp_view: {
    label: "open opportunity view"
    class: view
  }

  pending_view: {
    label: "pending signal view"
    class: view
  }

  exec_view: {
    label: "portfolio / trade result view"
    class: view
  }

  learn_view: {
    label: "learning context view"
    class: view
  }
}

opportunity_generation: {
  label: "3. Opportunity Generation / 机会生成层"
