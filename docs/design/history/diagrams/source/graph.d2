# =========================
# Raw Inputs -> Collectors
# =========================
raw.market_info -> collect.market_data_job: "OHLCV / indicators"
raw.market_info -> collect.price_feed: "latest price"

raw.microstructure -> collect.data_collectors: "orderbook / funding / OI / liquidation"
raw.news_social -> collect.news_fetch: "RSS / headlines"
raw.us_indices -> collect.data_collectors: "macro / risk context"
raw.xstocks -> collect.equity_observer: "equity + token prices"
raw.prediction_markets -> collect.prediction_observer: "prediction market data"
raw.serenity_sources -> collect.research_load_context: "research context"
raw.account_state -> collect.exchange_sync: "exchange/account state"

# =========================
# Collector Internal Flow
# =========================
collect.news_fetch -> collect.news_analyzer: "new news_items"
collect.research_load_context -> collect.research_collect_evidence
collect.research_collect_evidence -> collect.research_extract_claims
collect.research_extract_claims -> collect.research_cluster_themes
collect.research_cluster_themes -> collect.research_generate_opps
collect.exchange_sync -> collect.reconciliation: "exchange state -> local sync"

# =========================
# Collectors -> Store
# =========================
collect.market_data_job -> store.market_tables: "OHLCV / snapshots"
collect.price_feed -> store.market_tables: "cached prices"
collect.data_collectors -> store.micro_tables: "micro / macro rows"
collect.news_analyzer -> store.info_tables: "analyzed news_items"
collect.prediction_observer -> store.info_tables: "prediction rows"
collect.equity_observer -> store.equity_records: "equity read + token deviation"
collect.equity_observer -> store.opportunities: "equity opportunities"
collect.research_generate_opps -> store.serenity_tables: "serenity artifacts"
collect.research_generate_opps -> store.learning_store: "research evidence / claims"
collect.reconciliation -> store.execution_tables: "orders / fills / positions"

# =========================
# Store Read Views
# =========================
store.market_tables -> store.market_view
store.micro_tables -> store.market_view
store.info_tables -> store.info_view
store.equity_records -> store.equity_records
store.serenity_tables -> store.serenity_view
store.opportunities -> store.opp_view
store.pi_decisions -> store.pending_view
store.execution_tables -> store.exec_view
store.learning_store -> store.learn_view

# =========================
# Store -> Opportunity Generation
# =========================
store.market_view -> opportunity_generation.feature_collection: "features"
store.market_view -> opportunity_generation.market_context_builder: "market context"
store.market_view -> opportunity_generation.equity_read: "price/TA context"
store.info_view -> opportunity_generation.market_context_builder: "news / prediction context"
store.learn_view -> opportunity_generation.market_context_builder: "memory / lessons"
store.equity_records -> opportunity_generation.equity_read: "equity state"
store.serenity_view -> opportunity_generation.serenity_theme_read: "themes / opps"

# =========================
# Opportunity Generation Internal Flow
# =========================
opportunity_generation.feature_collection -> opportunity_generation.tradability_filter
opportunity_generation.tradability_filter -> opportunity_generation.scanner_scoring
opportunity_generation.scanner_scoring -> opportunity_generation.family_allocation
opportunity_generation.family_allocation -> opportunity_generation.universe_signal_emitter

opportunity_generation.market_context_builder -> opportunity_generation.market_observer
opportunity_generation.market_observer -> opportunity_generation.market_read_output

opportunity_generation.equity_read -> opportunity_generation.equity_opportunity
opportunity_generation.serenity_theme_read -> opportunity_generation.serenity_promote

# =========================
# Opportunity Generation -> Store
# =========================
opportunity_generation.universe_signal_emitter -> store.opportunities: "deterministic opportunities"
opportunity_generation.market_read_output -> store.opportunities: "LLM market opportunities"
opportunity_generation.equity_opportunity -> store.opportunities: "equity opportunity rows"
opportunity_generation.serenity_promote -> store.pi_decisions: "signal_pending / serenity"

# =========================
# Store -> Candidate Selection
# =========================
store.opp_view -> candidate_selection.list_open_opps: "open opportunities"
store.learn_view -> candidate_selection.candidate_enrichment: "factor / guard / memo"
store.market_view -> candidate_selection.candidate_enrichment: "regime / price"
store.micro_tables -> candidate_selection.candidate_enrichment: "funding / OI / tradability"

# =========================
# Candidate Selection Internal Flow
# =========================
candidate_selection.list_open_opps -> candidate_selection.candidate_gates
candidate_selection.candidate_gates -> candidate_selection.candidate_enrichment
candidate_selection.candidate_enrichment -> candidate_selection.score_candidates
candidate_selection.score_candidates -> candidate_selection.ranked_candidates
candidate_selection.ranked_candidates -> candidate_selection.shadow_trades: "top-N"
candidate_selection.ranked_candidates -> candidate_selection.select_topn: "eligible candidates"
candidate_selection.select_topn -> candidate_selection.write_signal_pending

# =========================
# Candidate Selection -> Store
# =========================
candidate_selection.shadow_trades -> store.learning_store: "counterfactual top-N"
candidate_selection.write_signal_pending -> store.pi_decisions: "signal_pending"

# =========================
# Store -> System Operator Context
# =========================
store.pending_view -> system_operator.read_pending_signal

store.market_view -> system_operator.layer1: "features / prices"
store.micro_tables -> system_operator.layer1: "funding / OI / liquidation"
store.opp_view -> system_operator.layer1: "open opportunities"
store.exec_view -> system_operator.layer1: "positions / balance / risk"

store.exec_view -> system_operator.layer2: "7d outcomes"
store.learn_view -> system_operator.layer2: "memo / feedback"
store.pending_view -> system_operator.layer2: "pending signals"

store.learn_view -> system_operator.layer3: "lessons / guards"
store.serenity_view -> system_operator.layer3: "Serenity opportunities"

# =========================
# System Operator Internal Flow
# =========================
system_operator.layer1 -> system_operator.trading_context
system_operator.layer2 -> system_operator.trading_context
system_operator.layer3 -> system_operator.trading_context
system_operator.read_pending_signal -> system_operator.llm_assessment
system_operator.trading_context -> system_operator.llm_assessment
system_operator.llm_assessment -> system_operator.bull_bear_debate: "if conviction 40-80"
system_operator.bull_bear_debate -> system_operator.conviction_sizing
system_operator.llm_assessment -> system_operator.conviction_sizing: "if no debate"
system_operator.conviction_sizing -> system_operator.trading_decision

# =========================
# System Operator -> Risk & Execution
# =========================
system_operator.trading_decision -> risk_execution.proposal_builder: "trade / scale_in / flip"
risk_execution.proposal_builder -> risk_execution.paper_tool: "paper/demo proposal"
risk_execution.paper_tool -> risk_execution.trade_proposal

# =========================
# Risk & Execution Internal Flow
# =========================
risk_execution.trade_proposal -> risk_execution.execution_gateway
risk_execution.execution_gateway -> risk_execution.risk_engine
risk_execution.risk_engine -> risk_execution.risk_rejected: "not approved"
risk_execution.risk_engine -> risk_execution.risk_approved: "approved"
risk_execution.risk_approved -> risk_execution.symbol_check
risk_execution.symbol_check -> risk_execution.paper_broker: "paper_internal"
risk_execution.symbol_check -> risk_execution.demo_broker: "demo/testnet"
risk_execution.symbol_check -> risk_execution.live_broker: "live_limited"
risk_execution.paper_broker -> risk_execution.orders
risk_execution.demo_broker -> risk_execution.orders
risk_execution.live_broker -> risk_execution.orders
risk_execution.orders -> risk_execution.fills
risk_execution.fills -> risk_execution.positions
risk_execution.positions -> risk_execution.position_manager

# =========================
# Risk & Execution -> Store
# =========================
risk_execution.trade_proposal -> store.execution_tables: "proposal row"
risk_execution.risk_rejected -> store.execution_tables: "risk decision / rejected"
risk_execution.risk_approved -> store.execution_tables: "risk decision / approved"
risk_execution.orders -> store.execution_tables
risk_execution.fills -> store.execution_tables
risk_execution.position_manager -> store.execution_tables: "position updates"

# =========================
# Store -> Learning
# =========================
store.exec_view -> learning.closed_position_reader: "closed positions"
store.opp_view -> learning.outcome_settler: "forward outcomes"
store.market_view -> learning.outcome_settler: "future price"

# =========================
# Learning Internal Flow
# =========================
learning.closed_position_reader -> learning.trade_attribution
learning.trade_attribution -> learning.factor_feedback
learning.closed_position_reader -> learning.post_trade_reviewer
learning.post_trade_reviewer -> learning.trade_case_study
learning.closed_position_reader -> learning.risk_critic
learning.risk_critic -> learning.guard_candidate
learning.guard_candidate -> learning.guard_promotion
learning.outcome_settler -> learning.factor_feedback
learning.trade_attribution -> learning.insight_synthesizer
learning.trade_case_study -> learning.insight_synthesizer

# =========================
# Learning -> Store
# =========================
learning.factor_feedback -> store.learning_store
learning.trade_case_study -> store.learning_store
learning.guard_promotion -> store.learning_store
learning.insight_synthesizer -> store.learning_store

# =========================
# Feedback Back Into Active Path
# =========================
store.learn_view -> candidate_selection.candidate_enrichment: "factor / guard / memo feedback"
store.learn_view -> system_operator.layer2: "trading memo"
store.learn_view -> system_operator.layer3: "lessons / guards"

# =========================
# Human Control
# =========================
human_control.dashboard -> human_control.inspect
human_control.dashboard -> human_control.settings
human_control.dashboard -> human_control.command_center
human_control.settings -> human_control.live_unlock

human_control.inspect -> store.opportunities: "inspect opportunities"
human_control.inspect -> store.execution_tables: "inspect proposals / positions"
human_control.inspect -> store.serenity_tables: "inspect Serenity"
human_control.settings -> store.learning_store: "config / model / risk setting records"
human_control.settings -> risk_execution.risk_engine: "risk config"
human_control.command_center -> system_operator.read_pending_signal: "manual inspection / command"
human_control.live_unlock -> risk_execution.live_broker: "enable live_limited path"
