  }

  score_candidates: {
    label: "trade_score computation"
    class: ranker
  }

  ranked_candidates: {
    label: "ranked candidates"
    class: ranker
  }

  shadow_trades: {
    label: "shadow_trades\ntop-N counterfactuals"
    class: ranker
    style.stroke-dash: 5
  }

  select_topn: {
    label: "select top candidates\ndedupe symbol / direction"
    class: ranker
  }

  write_signal_pending: {
    label: "write PiDecision\naction=signal_pending"
    class: ranker
  }
}

system_operator: {
  label: "5. System Operator / AI 决策层"
  style.fill: "#F3EFFF"

  layer1: {
    label: "Layer 1\nEnvironment Snapshot\n- positions\n- balance\n- regime\n- features\n- opportunities\n- risk"
    class: decision
  }

  layer2: {
    label: "Layer 2\nShort-term Memory\n- 7d outcomes\n- trade analytics\n- memo\n- ranker candidates\n- pending signals"
