  }

  layer3: {
    label: "Layer 3\nLong-term Wisdom\n- trade cases\n- lessons\n- guard candidates\n- Serenity opportunities"
    class: decision
  }

  trading_context: {
    label: "trading_context builder"
    class: decision
  }

  read_pending_signal: {
    label: "read signal_pending"
    class: decision
  }

  llm_assessment: {
    label: "LLM structured assessment\ntrade / skip / watch / scale_in / flip"
    class: decision
  }

  bull_bear_debate: {
    label: "bull / bear debate\nif conviction 40-80"
    class: decision
  }

  conviction_sizing: {
    label: "conviction sizing\nmarket_type / leverage"
    class: decision
  }

  trading_decision: {
    label: "TradingDecision"
    class: decision
  }
}

risk_execution: {
  label: "6. Risk & Execution / 风控执行层"
