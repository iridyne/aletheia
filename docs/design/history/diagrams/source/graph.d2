  feature_collection: {
    label: "universe feature collection"
    class: signal
  }

  tradability_filter: {
    label: "tradability filter"
    class: signal
  }

  scanner_scoring: {
    label: "scanner scoring\n- momentum\n- mean_reversion\n- volatility\n- derivatives\n- event\n- short_bias"
