  }

  equity_read: {
    label: "equity read\n- daily TA\n- token deviation"
    class: signal
  }

  equity_opportunity: {
    label: "equity opportunity\nobservation / shadow first"
    class: signal
  }

  serenity_theme_read: {
    label: "Serenity theme / opportunity read"
    class: signal
  }

  serenity_promote: {
    label: "Serenity promote\ntheme -> signal_pending"
    class: signal
  }
}

candidate_selection: {
  label: "4. Candidate Selection / 候选筛选层"
  style.fill: "#FFF8E8"

  list_open_opps: {
    label: "list_open_opportunities"
    class: ranker
  }

  candidate_gates: {
    label: "candidate gates\n- asset_class\n- status=open\n- execution_eligible\n- symbol filter\n- direction\n- confidence\n- TTL"
