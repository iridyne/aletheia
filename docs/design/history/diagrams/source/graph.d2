  label: "8. Human Control / 人类控制面"
  style.fill: "#FFF9DF"

  dashboard: {
    label: "Dashboard"
    class: human
  }

  inspect: {
    label: "inspect\n- opportunities\n- proposals\n- positions\n- Serenity"
    class: human
  }

  settings: {
    label: "settings\n- credentials\n- model provider\n- risk config"
    class: human
  }

  command_center: {
    label: "Command Center"
    class: human
  }

  live_unlock: {
    label: "live unlock\nexplicit human action"
    class: human
  }
