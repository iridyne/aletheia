}

learning: {
  label: "7. Feedback & Learning / 反馈学习层"
  style.fill: "#EEFCFB"

  closed_position_reader: {
    label: "closed position reader"
    class: learning
  }

  trade_attribution: {
    label: "trade_attribution\n- scanner_family\n- symbol\n- direction\n- exit_reason\n- PnL"
    class: learning
  }

  factor_feedback: {
    label: "factor_feedback\n- preferred\n- blocked_candidate\n- hard_blocked"
