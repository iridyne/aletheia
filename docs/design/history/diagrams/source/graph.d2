direction: down

classes: {
  source: {
    style.fill: "#EEF6FF"
    style.stroke: "#5B8DEF"
  }
  collector: {
    style.fill: "#F8FBFF"
    style.stroke: "#7A9FD6"
  }
  store: {
    shape: cylinder
    style.fill: "#F7F7F7"
    style.stroke: "#555555"
  }
  view: {
    style.fill: "#FFFFFF"
    style.stroke: "#999999"
    style.stroke-dash: 4
  }
  signal: {
    style.fill: "#ECFFF1"
    style.stroke: "#4AA564"
  }
  agent: {
    style.fill: "#F3EFFF"
    style.stroke: "#8B6FE8"
  }
  ranker: {
    style.fill: "#FFF8E8"
    style.stroke: "#D6A63A"
  }
  decision: {
    style.fill: "#EEE6FF"
    style.stroke: "#7D55D9"
  }
  risk: {
    style.fill: "#FFE2E2"
    style.stroke: "#D33"
    style.stroke-width: 3
  }
  execution: {
    style.fill: "#FFF0F0"
    style.stroke: "#D65F5F"
  }
  learning: {
    style.fill: "#EAFFFB"
    style.stroke: "#4BB5A8"
  }
  human: {
    style.fill: "#FFF2B8"
    style.stroke: "#C89B00"
  }
}

raw: {
  label: "0. Raw Inputs / 外部信息源"
  style.fill: "#EEF6FF"

  market_info: {
    label: "market_info\n- multi TF K-line\n- TA indicators\n- price feed"
    class: source
  }

  microstructure: {
    label: "market_microstructure\n- orderbook\n- funding\n- OI\n- liquidations"
    class: source
  }

  news_social: {
    label: "News / Social / Macro\n- RSS news\n- political / economical\n- trend info"
    class: source
  }

  us_indices: {
    label: "US Stocks / Macro Indices\n- VIX\n- SPY\n- QQQ\n- risk regime"
    class: source
  }

  xstocks: {
    label: "US Stocks / X Stocks\n- yfinance\n- Bitget stock tokens\n- token deviation"
    class: source
  }

  prediction_markets: {
    label: "Prediction Markets\n- active markets\n- probability momentum"
    class: source
  }

  serenity_sources: {
    label: "Serenity Research Sources\n- internet research\n- evidence materials\n- industry-chain info"
    class: source
  }

  account_state: {
    label: "Account / Exchange State\n- balance\n- open positions\n- fills\n- PnL"
    class: source
  }
}

