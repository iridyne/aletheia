  orders: {
    label: "orders"
    class: execution
  }

  fills: {
    label: "fills"
    class: execution
  }

  positions: {
    label: "positions"
    class: execution
  }

  position_manager: {
    label: "position_manager\n- TP/SL\n- close / reduce\n- reconcile"
