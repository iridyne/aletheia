direction: down

classes: {
  planning: { style.fill: "#F2ECFF"; style.stroke: "#7452B8" }
  safety: { style.fill: "#FFE9E7"; style.stroke: "#C33D32"; style.stroke-width: 3 }
  execution: { style.fill: "#FFF2E8"; style.stroke: "#C4672D" }
  store: { shape: cylinder; style.fill: "#F4F6F8"; style.stroke: "#5E6873" }
}

title: "Entry Plan, Risk & External Execution / 入场与外部执行" {
  near: top-center
  shape: text
  style.font-size: 26
  style.bold: true
}

planning: "Entry planning / 入场规划" {
  class: planning
  candidate: "Candidate + Planning Generation"
  planner: "Planner hypothesis / 入场假设"
  compiler: "Compiler / 价格、风险与执行上下文"
  plan: "Entry Plan / 当前路由：Bitget Demo"
}

proposal: "Immutable TradeProposal / 可追溯交易提案" { class: execution }
gateway: "Execution Gateway / 唯一下单入口" { class: safety }
risk: "Risk Engine / 下单前审批" {
  class: safety
  label: "Risk Engine / 下单前审批\n权限 · 账户 · 价格 · 暴露 · 亏损 · kill switch"
}
rejected: "RiskDecision: rejected / 禁止下单" { class: safety }
coordinator: "Coordinator + UTA / 明确的外部账户" { class: execution }
order: "Order submitted / 提交不等于成交" { class: store }
private_fill: "Private exchange fills / 私有成交证据\n账户 · 订单 · 数量 · 价格 · 费用 · 时间" { class: execution }
ledger: "Fill + Position / 按真实成交物化" { class: store }
audit: "Audit + account truth / 审计与账户事实" { class: store }
boundary: "模式注册不代表账户已配置或通过资格验证\n无本地模拟回退；Live 默认关闭，须单独授权" {
  shape: text
  style.font-size: 17
}

planning.candidate -> planning.planner
planning.planner -> planning.compiler
planning.compiler -> planning.plan
planning.plan -> proposal
proposal -> gateway
gateway -> risk
risk -> rejected: "reject"
risk -> coordinator: "approve"
coordinator -> order
order -> private_fill: "reconcile / 核对"
private_fill -> ledger
ledger -> audit
boundary -> coordinator: { style.stroke-dash: 5 }
