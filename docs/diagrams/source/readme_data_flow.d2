direction: down

classes: {
  source: { style.fill: "#E8F1FF"; style.stroke: "#3973B7" }
  process: { style.fill: "#EDF8FF"; style.stroke: "#397BA8" }
  store: { shape: cylinder; style.fill: "#F4F6F8"; style.stroke: "#5E6873" }
  decision: { style.fill: "#F2ECFF"; style.stroke: "#7452B8" }
  trade: { style.fill: "#FFEDE8"; style.stroke: "#C45C3D" }
  learning: { style.fill: "#E8F8F0"; style.stroke: "#27866A" }
}

title: "End-to-End Data Flow / 端到端数据流" {
  near: top-center
  shape: text
  style.font-size: 26
  style.bold: true
}

sources: "External facts / 外部事实" {
  class: source
  market: "Market venues\nprice · OHLCV · microstructure"
  context: "Context\nnews · macro · prediction · research"
  account: "Exchange/account\nbalance · positions · fills"
}

ingest: "Ingestion & normalization / 采集规范化" {
  class: process
  collect: "Scheduled collectors"
  canonical: "Canonical instrument identity\nsymbol · market_type · venue"
  feature: "Feature + quality computation\n含 freshness 与 source manifest"
}

market_store: "Market truth\nmarket snapshots · OHLCV · universe features\norder book · funding · OI · news" { class: store }

discovery: "Candidate discovery / 候选发现" {
  class: process
  universe: "Universe scanners\n成员与特征事实"
  serenity: "Serenity Candidate publication\npublish_serenity_candidates · 不经 Universe Utility"
  utility: "Candidate Selection Utility\n确定性准入"
  generation: "Planning Generation\nsource/context/期限冻结"
}

decision_store: "Decision truth\nCandidate · Planning Generation · Entry Plan" { class: store }

operator: "System Operator Entry Planner\nexact Planning Generation + bounded context\n→ EntryHypothesis" { class: decision }

execution: "Risk & execution / 风控执行" {
  class: trade
  proposal: "TradeProposal"
  risk: "RiskDecision"
  order: "Order · Fill · Position"
}

trade_store: "Trading truth\nproposals · risk decisions · orders · fills\npositions · account events · audits" { class: store }

settlement: "Settlement & evidence / 结算与证据" {
  class: learning
  net: "Cost-complete net outcome"
  attribution: "Attribution + forward/shadow outcomes"
  review: "Review · cases · lessons · memo"
  measure: "Contribution measurement"
}

learning_store: "Learning truth\nknowledge · lessons · guards · memo\nexposures · verdicts · lifecycle events" { class: store }

sources.market -> ingest.collect
sources.context -> ingest.collect
sources.account -> ingest.collect
ingest.collect -> ingest.canonical
ingest.canonical -> ingest.feature
ingest.feature -> market_store
market_store -> discovery.universe
discovery.universe -> discovery.utility
discovery.utility -> discovery.generation
discovery.serenity -> discovery.generation
discovery.generation -> decision_store
decision_store -> operator
learning_store -> operator: "retrieved evidence" { style.stroke-dash: 5 }
operator -> execution.proposal: "compiled Entry Plan"
operator -> decision_store: "NO_PLAN / unavailable"
execution.proposal -> execution.risk
execution.risk -> execution.order: "approved only"
execution.order -> trade_store
trade_store -> settlement.net
market_store -> settlement.attribution: "future prices"
settlement.net -> settlement.attribution
settlement.attribution -> settlement.review
settlement.review -> settlement.measure
settlement.measure -> learning_store
learning_store -> discovery.utility: "bounded selection evidence" { style.stroke-dash: 5 }
