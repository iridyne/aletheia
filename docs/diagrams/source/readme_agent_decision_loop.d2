direction: down

classes: {
  signal: { style.fill: "#E8F6FF"; style.stroke: "#397BA8" }
  memory: { style.fill: "#EAF8F1"; style.stroke: "#2E8B67" }
  operator: { style.fill: "#F2ECFF"; style.stroke: "#7452B8"; style.stroke-width: 3 }
  terminal: { style.fill: "#FFF3D9"; style.stroke: "#B47B16" }
  safety: { style.fill: "#FFE8E5"; style.stroke: "#C33D32"; style.stroke-width: 3 }
}

title: "Agent Decision Loop / Agent 决策闭环" {
  near: top-center
  shape: text
  style.font-size: 26
  style.bold: true
}

producers: "Candidate and evidence producers / 候选与证据生产者" {
  universe: "Universe scanners\n确定性特征与 Candidate Selection Utility" { class: signal }
  observer: "Market Observer\nLLM advisory enrichment" { class: signal }
  research: "Serenity / equity / prediction observers\n研究与跨市场观察" { class: signal }
}

opportunity: "Candidate source evidence\nexact snapshot · source manifest · capability" { class: signal }

candidate: "Durable Candidate Planning Generation" {
  class: signal
  gates: "Selection gates\ntradability · expiry · direction · dedupe"
  context: "Frozen source/context\ncycle lineage · exact instrument · deadlines"
}

context: "Three-layer decision context / 三层决策上下文" {
  market: "1 · Environment\nmarket · features · regime · risk"
  portfolio: "2 · Current state\npositions · balance · recent outcomes"
  wisdom: "3 · Long-term wisdom\ncases · lessons · memo · guards"
}

operator: "System Operator / 唯一 AI 入场决策者" {
  class: operator
  hydrate: "Hydrate one exact candidate\n按因果 ID 读取候选"
  reason: "Structured EntryHypothesis\n证据化推理与事实引用"
  decide: "Planning decision\nENTRY_PLAN · NO_PLAN · unavailable"
}

terminal: "Planning outcomes / 规划出口" {
  plan: "ENTRY_PLAN → immutable Entry Plan" { class: terminal }
  no_plan: "NO_PLAN → typed reason" { class: terminal }
  unavailable: "blocked/unavailable → bounded retry or owner input" { class: terminal }
}

safety: "Risk Engine + Execution Gateway\nAI 决策不能绕过硬性风控" { class: safety }

producers.universe -> opportunity
producers.observer -> opportunity: "advisory only"
producers.research -> opportunity: "observation only"
opportunity -> candidate.gates
candidate.gates -> candidate.context
candidate.context -> operator.hydrate
context.market -> operator.reason
context.portfolio -> operator.reason
context.wisdom -> operator.reason
operator.hydrate -> operator.reason
operator.reason -> operator.decide
operator.decide -> terminal.plan
operator.decide -> terminal.no_plan
operator.decide -> terminal.unavailable
terminal.plan -> safety
terminal.no_plan -> context.portfolio: "future review" { style.stroke-dash: 5 }
terminal.unavailable -> candidate.context: "resume same cycle" { style.stroke-dash: 5 }
