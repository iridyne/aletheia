%%{init: {'theme': 'dark', 'themeVariables': {'primaryColor': '#1a1a2e', 'primaryTextColor': '#e0e0e0', 'primaryBorderColor': '#4a9eff', 'lineColor': '#4a9eff', 'fontFamily': 'sans-serif'}}}%%
flowchart TD
    subgraph BRAIN["🧠 决策中枢"]
        PI["<b>PI Agent</b><br/>唯一决策者<br/>每5分钟评估一次"]
    end

    subgraph EYES["👁️ 感知层"]
        OBS["Market Observer<br/>市场感知 (10min)"]
        FEAT["Universe Features<br/>特征计算"]
    end

    subgraph HANDS["🤖 执行层"]
        PT["Paper Trader<br/>信号收集器 (5min)"]
        GW["Execution Gateway<br/>下单执行"]
    end

    subgraph STRATEGY["📐 策略层"]
        SD["Strategy Designer<br/>策略创建+回测"]
        OP["Operator Loop<br/>策略运营 (60min)"]
    end

    subgraph SAFETY["🛡️ 安全层 (自治)"]
        RISK["Risk Engine"]
        PM["Position Manager<br/>止损/止盈/追踪"]
    end

    subgraph MEMORY["💾 记忆层"]
        DB[("SQLite DB<br/>pi_decisions<br/>positions<br/>strategies")]
        KB["Knowledge Base<br/>lessons + reflections"]
    end

    OBS -->|"Opportunities<br/>(方向+信心)"| PT
    FEAT -->|"特征数据"| PI
    PT -->|"signal_pending"| DB
    DB -->|"pending signals"| PI
    PI -->|"trade 决策"| GW
    GW --> RISK -->|"approved"| PM
    SD -->|"recommend_promote"| PI
    OP -->|"recommend_retire"| PI
    PI -->|"confirm"| SD & OP
    PM -->|"trade outcome"| KB
    KB -->|"反馈注入"| PI

    classDef brain fill:#0f3460,stroke:#ffd700,stroke-width:3px,color:#ffd700
    classDef eyes fill:#1a2e1a,stroke:#88ff88,stroke-width:2px,color:#88ff88
    classDef hands fill:#1a1a2e,stroke:#4a9eff,stroke-width:2px,color:#4a9eff
    classDef safety fill:#2d1b1b,stroke:#ff6b6b,stroke-width:2px,color:#ff6b6b
    classDef memory fill:#2e1a2e,stroke:#cc88ff,stroke-width:2px,color:#cc88ff

    class PI brain
    class OBS,FEAT eyes
    class PT,GW hands
    class RISK,PM safety
    class DB,KB memory
