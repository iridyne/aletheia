{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aletheia/policy.schema.json",
  "title": "Aletheia agent trust-boundary policy",
  "type": "object",
  "required": ["schema_version", "trust_boundaries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "trust_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "paths", "required_command_keys"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "description": {"type": "string"},
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "required_command_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
