{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "id", "title", "status", "scope", "intent", "acceptance", "ownership", "base_commit", "next_action", "handoff"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^TASK-[A-Za-z0-9_-]+$"},
    "status": {"enum": ["backlog", "ready", "in_progress", "blocked", "done", "cancelled"]},
    "base_commit": {"type": "string", "minLength": 7},
    "handoff": {"type": "string", "pattern": "^\\.agent/handoffs/TASK-[A-Za-z0-9_-]+\\.md$"}
  }
}
