# Legacy runtime migration source only (repo-root anchored). A bare `data/` also matches the
# SOURCE package aletheia/data/ at every level — which silently excluded it from
# git and broke the checkout. Keep the leading slash so it stays root-scoped.
/data/
*.db
*.pid
.secret.key
secrets.enc
node_modules/
frontend/dist/
# Frontend build artifacts — gitignored; run `cd frontend && npm run build` before first use or after UI changes.
aletheia/dashboard_static/
.pytest_cache/
.pytest_cache_ai/
url-to-markdown/

# === AI Workspace Safety Rules ===
# Claude Code local/private state
.claude/settings.local.json
.claude/plans/
.claude/worktrees/
CLAUDE.local.md

# External skill toolkits (not part of this repo)
.baoyu-skills/

# pi / pi-lens local config (pi-lens auto-format and autofix settings)
.pi-lens.json
pi-lens.json
.pi-subagents/

# Trae local/private state
.trae/

# Codex local/private state
.codex/auth*
.codex/session*
.codex/cache/
.codex/tmp/

# OS files
.DS_Store
Thumbs.db

# Vite dependency pre-bundling cache (build artifact)
.vite/

# TypeScript incremental build cache
frontend/tsconfig.tsbuildinfo

# Test runner output
test-results/

# Rust host build output; Cargo.lock is tracked for reproducible packaged binaries.
native/aletheia-host/target/

# Chat exports (large personal conversation dumps — keep out of repo history)
docs/ChatExport_*/
docs/ChatExport_*.zip

# OMC / review tooling state (Workspace Claude Code session artifacts)
.omc/

# Quant-review snapshots / scratch (one-off byproducts, not source)
docs/review/tmp/
docs/**/*.bak
docs/**/*.before-fix

# UFC monitor operational log (append-only, written concurrently by two CASI
# instances -- tracking it would conflict on every run). The check script is tracked.
docs/monitoring/ufc_casi_monitor_state.md
