#!/bin/sh
# Aletheia pre-commit hook — cheap gate only, never pytest.
#
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# scripts/dev/dev-init.sh installs it automatically.
#
# The gate is scripts/ci/dev_check.py --staged: secret/.env refusal, whitespace
# hygiene, ruff (E/F plus B/ASYNC/RUF, reported on staged lines only) and the
# test-hygiene census. Types and tests are deliberately excluded here — run the
# full loop yourself with: uv run python scripts/ci/dev_check.py
#
# If the gate script cannot be found, this hook says so explicitly instead of
# reporting a gate failure: a moved gate must not look like a finding in the
# staged change.

RED='\033[0;31m'
NC='\033[0m'

fail() {
    printf '%s\n' "${RED}$1${NC}" >&2
    exit 1
}

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

if printf '%s\n' "$STAGED" | grep -qE '^\.(env|env\..*)$'; then
    fail "ERROR: Attempting to commit .env file. Aborting. Remove with: git reset HEAD .env"
fi

SECRETS_PATTERN='(PRIVATE_KEY|API_KEY|SECRET_KEY|ACCESS_TOKEN|sk-[a-zA-Z0-9]{20,}|dapi[a-f0-9]{32,})'
if git diff --cached -U0 | grep -qE "$SECRETS_PATTERN"; then
    fail "ERROR: Possible secret/token detected in staged changes. Review carefully. To bypass a verified false positive: git commit --no-verify"
fi

# Resolve the gate instead of hardcoding it: .git/hooks is shared by every
# worktree of this repository, and a worktree checked out at an older revision can
# reinstall its own copy of this hook. Discovery means a moved gate does not brick
# commits for everyone who still has an older installed hook.
GATE=$(git ls-files --full-name -- 'scripts/**/dev_check.py' 2>/dev/null | head -n 1)
[ -n "$GATE" ] || GATE=scripts/ci/dev_check.py
[ -f "$GATE" ] || fail "ERROR: the cheap gate is not where this hook expects it (looked for scripts/**/dev_check.py). This is NOT a finding in your staged changes; reinstall the hook from the main checkout: cp scripts/hooks/pre-commit .git/hooks/pre-commit"

uv run python "$GATE" --staged --no-tests --no-types \
    || fail "ERROR: staged changes failed the cheap gate (see above). Bypass only for a verified false positive: git commit --no-verify"

exit 0
