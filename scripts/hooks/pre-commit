#!/bin/sh
# Optional pre-commit hook for Aletheia.
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Purpose: block likely secrets and print focused trust-boundary test hints.
# Task Lite is machine-local and never requires Git-tracked task or handoff files.

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Check for .env files being committed.
if git diff --cached --name-only | grep -qE '^\.(env|env\..*)$'; then
    echo "${RED}ERROR: Attempting to commit .env file. Aborting.${NC}"
    echo "Remove with: git reset HEAD .env"
    exit 1
fi

# Check for common secret patterns in staged files.
SECRETS_PATTERN='(PRIVATE_KEY|API_KEY|SECRET_KEY|ACCESS_TOKEN|sk-[a-zA-Z0-9]{20,}|dapi[a-f0-9]{32,})'
if git diff --cached -U0 | grep -qE "$SECRETS_PATTERN"; then
    echo "${RED}WARNING: Possible secret/token detected in staged changes.${NC}"
    echo "Review carefully before committing."
    echo "To bypass (if false positive): git commit --no-verify"
    exit 1
fi

# Trust-boundary hints are advisory. Git/PR/CI own verification; Task Lite does
# not record proof or block commits based on local task metadata.
if [ -f .agent/policy.yaml ]; then
    STAGED=$(git diff --cached --name-only)
    if [ -n "$STAGED" ]; then
        TMP=$(mktemp -t aletheia-precommit-tb.XXXXXX)
        if printf '%s\n' "$STAGED" | uv run --quiet python scripts/agent_check_staged.py --paths-stdin >"$TMP" 2>&1; then
            if [ -s "$TMP" ]; then
                echo "${YELLOW}Trust-boundary test hints:${NC}"
                cat "$TMP"
            fi
        else
            echo "${YELLOW}Could not calculate trust-boundary hints; PR CI remains authoritative.${NC}"
            cat "$TMP"
        fi
        rm -f "$TMP"
    fi
fi

exit 0
