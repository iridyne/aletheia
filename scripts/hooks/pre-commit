#!/bin/sh
# Optional pre-commit hook for AI workspace projects.
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Purpose: Prevent accidental secret commits and remind about handoff docs.

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Check for .env files being committed
if git diff --cached --name-only | grep -qE '^\.(env|env\..*)$'; then
    echo "${RED}ERROR: Attempting to commit .env file. Aborting.${NC}"
    echo "Remove with: git reset HEAD .env"
    exit 1
fi

# Check for common secret patterns in staged files
SECRETS_PATTERN='(PRIVATE_KEY|API_KEY|SECRET_KEY|ACCESS_TOKEN|sk-[a-zA-Z0-9]{20,}|dapi[a-f0-9]{32,})'
if git diff --cached -U0 | grep -qE "$SECRETS_PATTERN"; then
    echo "${RED}WARNING: Possible secret/token detected in staged changes.${NC}"
    echo "Review carefully before committing."
    echo "To bypass (if false positive): git commit --no-verify"
    exit 1
fi

# Reminder about handoff docs (non-blocking)
if ! git diff --cached --name-only | grep -q 'docs/AI_HANDOFF.md'; then
    echo "${YELLOW}Reminder: Consider updating docs/AI_HANDOFF.md before pushing.${NC}"
fi

exit 0
