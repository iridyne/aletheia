#!/bin/sh
# Optional pre-commit hook for AI workspace projects.
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Purpose: Prevent accidental secret commits, remind about handoff docs, and
#          enforce the machine-readable trust-boundary policy in .agent/policy.yaml.

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Check for .env files being committed
if git diff --cached --name-only | grep -qE '^\.(env|env\..*)$'; then
    echo "${RED}ERROR: Attempting to commit .env file. Aborting.${NC}"
    echo "Remove with: git reset HEAD .env"
    exit 1
fi

# Check for common secret patterns in staged files
SECRETS_PATTERN='(PRIVATE_KEY|API_KEY|SECRET_KEY|ACCESS_TOKEN|sk-[a-zA-Z0-9]{20,}|dapi[a-f0-9]{32,})'
if git diff --cached -U0 | grep -qE "$SECRETS_PATTERN"; then
    echo "${RED}WARNING: Possible secret/token detected in staged changes.${NC}"
    echo "Review carefully before committing."
    echo "To bypass (if false positive): git commit --no-verify"
    exit 1
fi

# Session-continuity gate: governed changes must carry both durable records.
if git diff --cached --name-only | grep -qE '^(aletheia/|frontend/|tests/|docs/|scripts/|\.github/|\.agent/(commands\.yaml|project\.yaml|policy\.yaml|schemas/)|AGENTS\.md$|CURRENT_TASK\.md$|README\.md$|pyproject\.toml$|uv\.lock$)'; then
    if ! git diff --cached --name-only | grep -qE '^\.agent/(tasks|handoffs)/'; then
        echo "${RED}ERROR: code/docs changed without a tracked task packet or handoff update.${NC}"
        exit 1
    fi
    if ! git diff --cached --name-only | grep -qE '^\.agent/tasks/'; then
        echo "${RED}ERROR: code/docs changed without a task packet update.${NC}"
        exit 1
    fi
    if ! git diff --cached --name-only | grep -qE '^\.agent/handoffs/'; then
        echo "${RED}ERROR: code/docs changed without a handoff update.${NC}"
        exit 1
    fi
fi

# Trust-boundary gate: if any staged path matches .agent/policy.yaml, require
# passing task-packet evidence for the group. Delegates matching to the CLI so
# glob semantics stay in one place.
if [ -f .agent/policy.yaml ]; then
    STAGED=$(git diff --cached --name-only)
    if [ -n "$STAGED" ]; then
        TMP=$(mktemp -t aletheia-precommit-tb.XXXXXX)
        if ! printf '%s\n' "$STAGED" | uv run --quiet aletheia agent workflow check-staged --paths-stdin >"$TMP" 2>&1; then
            echo "${RED}ERROR: trust-boundary policy violation:${NC}"
            cat "$TMP"
            rm -f "$TMP"
            exit 1
        fi
        rm -f "$TMP"
    fi
fi

exit 0
